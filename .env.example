ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

POSTGRES_DB=backplane
POSTGRES_USER=backplane
POSTGRES_PASSWORD=backplane
DATABASE_URL=postgresql+asyncpg://backplane:backplane@postgres:5432/backplane
REDIS_URL=redis://redis:6379/0

# Generate independent random values before any non-local deployment.
JWT_SECRET=replace-with-at-least-32-random-characters-before-deploy
ENCRYPTION_KEY=replace-with-an-independent-random-encryption-passphrase
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
PUBLIC_API_URL=http://localhost:8000
MAX_WEBHOOK_BYTES=1048576
WEBHOOK_RATE_LIMIT=120
OUTBOUND_TIMEOUT_SECONDS=15
ALLOW_PRIVATE_NETWORKS=false

VITE_API_URL=/api/v1

